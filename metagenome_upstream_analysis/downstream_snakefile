    input:
        bamfile = "/nfs/turbo/lsa-vdeneflab/vdenef1-mistorage/Shared/lyucheng/nikesh_metG_assembly/graz_resist_genes/data/recruitment_map/just_genes/{sample_id}_{primer_seqid}_{slabel}_LE_pangenome_recruitment.id95.bam",
        bai_file = "/nfs/turbo/lsa-vdeneflab/vdenef1-mistorage/Shared/lyucheng/nikesh_metG_assembly/graz_resist_genes/data/recruitment_map/just_genes/{sample_id}_{primer_seqid}_{slabel}_LE_pangenome_recruitment.id95.bam.bai",
        reference = "data/references/microcystis_LE/pan_genome_reference.fa"
    output:
        profile_dir = directory("data/inStrain_output/IS_{sample_id}_{primer_seqid}_{slabel}_LE_pangenome/"),
        genome_info = "data/inStrain_output/IS_{sample_id}_{primer_seqid}_{slabel}_LE_pangenome/output/IS_{sample_id}_{primer_seqid}_{slabel}_LE_pangenome_genome_info.tsv"
    log: "logs/inStrain/{sample_id}_{primer_seqid}_{slabel}_LE_pangenome.log"

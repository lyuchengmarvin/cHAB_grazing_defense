    input: 
        expand("data/assembly/megahit/{sample_id}_{primer_seqid}", 
        zip,
        sample_id = wildcard_patterns.sample_id,
        primer_seqid = wildcard_patterns.primer_seqid)

rule run_assemble_biosyntheticSPAdes:
    input:
        expand("data/assembly/biosyntheticSPAdes/{sampleID}_scaffolds.fasta",
        sampleID = wildcard_patterns.sample_id)
    shell:
        """
        echo "BiosyntheticSPAdes assembly complete!"
        """


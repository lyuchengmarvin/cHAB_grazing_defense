    input:
        reads = "data/decontam_fastqs/{sample_id}_{primer_seqid}_decon_R{direction}.fastq.gz",
    output:
        report = "data/fastqc/{sample_id}_{primer_seqid}_decon_R{direction}_fastqc.html"
    params:
        out_dir = "data/fastqc"
    log: "logs/fastqc/{sample_id}_{primer_seqid}_decon_R{direction}_001.log"
    resources: time_min = 1000, cpus = 8, mem_mb = 50000, partition= "standard", account = "vdenef0"
    shell:
        """
        echo "Fastqc is already included in the Bioinformatics module on the GreatLakes. Loading modules..."
        module load Bioinformatics
        module load fastqc
        echo "Running FastQC on {input.reads}..."

        fastqc -o {params.out_dir} -t {resources.cpus} {input.reads} | tee {log}
        """

rule count_reads_fastp:
    input:
        raw_reads_fwd = BASE_DIR + "{sample_id}_{primer_seqid}_R1_001.fastq.gz",
        raw_reads_rev = BASE_DIR + "{sample_id}_{primer_seqid}_R2_001.fastq.gz",
        qual_filt_and_trimmed_fwd = "data/fastp/{sample_id}_{primer_seqid}_qcd_R1.fastq.gz",
        qual_filt_and_trimmed_rev = "data/fastp/{sample_id}_{primer_seqid}_qcd_R2.fastq.gz",
        decon_reads_fwd = "data/decontam_fastqs/{sample_id}_{primer_seqid}_decon_R1.fastq.gz",
        decon_reads_rev = "data/decontam_fastqs/{sample_id}_{primer_seqid}_decon_R2.fastq.gz"
    output:
        "data/read_stats/{sample_id}_{primer_seqid}_read_count_fastp.tsv"
    resources: cpus=4, partition= "standard", account = "vdenef0"
    shell:
        """
        printf "read_state\tfwd_read_count\trev_read_count\n" > {output} &&
        printf "raw_reads\t$(($(pigz -dc -p {resources.cpus} {input.raw_reads_fwd} | wc -l) / 4 ))\t$(($(pigz -dc -p {resources.cpus} {input.raw_reads_rev} | wc -l) / 4 ))\n" >> {output} &&
        printf "filt_and_trimmed_reads\t$(($(pigz -dc -p {resources.cpus} {input.qual_filt_and_trimmed_fwd} | wc -l) / 4 ))\t$(($(pigz -dc -p {resources.cpus} {input.qual_filt_and_trimmed_rev} | wc -l) / 4 ))\n" >> {output} &&
        printf "decon_reads\t$(($(pigz -dc -p {resources.cpus} {input.decon_reads_fwd} | wc -l) / 4 ))\t$(($(pigz -dc -p {resources.cpus} {input.decon_reads_rev} | wc -l) / 4 ))\n" >> {output}
        """


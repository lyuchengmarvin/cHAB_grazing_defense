rule megahit:
    input:
        decon_reads_fwd = "data/decontam_fastqs/{sample_id}_{primer_seqid}_decon_R1.fastq.gz",
        decon_reads_rev = "data/decontam_fastqs/{sample_id}_{primer_seqid}_decon_R2.fastq.gz"
    output:
        assembly_directory = directory("data/assembly/megahit/{sample_id}_{primer_seqid}")
    log: "logs/megahit/{sample_id}_{primer_seqid}.log"
    resources: cpus = 24, mem_mb = 180000, time_min = 7200, partition= "standard", account = "vdenef0"
    shell:
        """
        echo "megahit is already included in the Bioinformatics module on the GreatLakes. Loading modules..."
        module load Bioinformatics
        module load megahit
        megahit \
            -1 {input.decon_reads_fwd} \
            -2 {input.decon_reads_rev} \
            -t {resources.cpus} \
            --presets meta-sensitive \
            --memory 0.5 \
            -o {output.assembly_directory} 2>&1 | tee -a {log}
        """


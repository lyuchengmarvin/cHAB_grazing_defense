import os
import re
import subprocess
from snakemake.io import glob_wildcards
from glob import glob
import pandas as pd
import time

# This snakemake script is for processing Nikesh's feeding experiment metagenome samples

BASE_DIR = "/nfs/turbo/lsa-vdeneflab/vdenef1-mistorage/Shared/lyucheng/nikesh_metG_assembly/remaining/"

# Define the samples, primer sequences, and directions with wildcards
wildcard_patterns = glob_wildcards(
    BASE_DIR + "{sample_id}_{primer_seqid}_R{direction}_001.fastq.gz"
    )

rule run_fastqc:
    input:
        expand("data/fastqc/{sample_id}_{primer_seqid}_R{direction}_001_fastqc.html",
        zip, #Added zip, as a parameter to expand() to ensure it only creates combinations that actually exist in your data
        sample_id = wildcard_patterns.sample_id,
        primer_seqid = wildcard_patterns.primer_seqid,
        direction = wildcard_patterns.direction)
    shell:
        """
        echo "FastQC analysis complete!"
        """

rule run_fastp:
    input: 
        expand("data/fastp/{sample_id}_{primer_seqid}_qcd_R{direction}.fastq.gz", 
            zip,
            sample_id = wildcard_patterns.sample_id, 
            primer_seqid = wildcard_patterns.primer_seqid, 
            direction = wildcard_patterns.direction)
    shell:
        """
        echo "FastP deduplication and trimming complete!"
        """

rule run_human_read_removal:
    input: 
        expand("data/decontam_fastqs/{sample_id}_{primer_seqid}_decon_R{direction}.fastq.gz", 
            zip,
            sample_id = wildcard_patterns.sample_id,
            primer_seqid = wildcard_patterns.primer_seqid,
            direction = wildcard_patterns.direction) + \
        expand("data/read_stats/{sample_id}_{primer_seqid}_read_count_fastp.tsv", 
            zip,
            sample_id = wildcard_patterns.sample_id,
            primer_seqid = wildcard_patterns.primer_seqid)
    shell:
        """
        echo "Contaminant reads removal and read counting complete!"
        """

rule run_post_fastqc:
    input:
        expand("data/fastqc/{sample_id}_{primer_seqid}_decon_R{direction}_001_fastqc.html",
        zip, #Added zip, as a parameter to expand() to ensure it only creates combinations that actually exist in your data
        sample_id = wildcard_patterns.sample_id,
        primer_seqid = wildcard_patterns.primer_seqid,
        direction = wildcard_patterns.direction)
    shell:
        """
        echo "FastQC analysis complete!"
        """
